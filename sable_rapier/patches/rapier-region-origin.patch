 impl NarrowPhase {
+    /// Import remapped persistent contact data, including manifold workspaces and solver impulses.
+    pub fn planetary_import_contact(&mut self, colliders: &ColliderSet, pair: ContactPair) {
+        let a = pair.collider1;
+        let b = pair.collider2;
+        self.add_pair(colliders, &ColliderPair { collider1: a, collider2: b });
+        let ga = self.graph_indices.get(a.0).unwrap().contact_graph_index;
+        let gb = self.graph_indices.get(b.0).unwrap().contact_graph_index;
+        let edge = self.contact_graph.graph.find_edge(ga, gb).unwrap();
+        *self.contact_graph.graph.edge_weight_mut(edge).unwrap() = pair;
+    }
+    /// Contact anchors/warm starts are local. Only cached solver world points translate.
+    pub fn planetary_shift_origin(&mut self, delta: crate::math::Vector) {
+        for edge in &mut self.contact_graph.graph.edges {
+            for manifold in &mut edge.weight.manifolds {
+                for contact in &mut manifold.data.solver_contacts { contact.point -= delta; }
+            }
+        }
+    }
+
     /// Creates a new empty narrow-phase.
