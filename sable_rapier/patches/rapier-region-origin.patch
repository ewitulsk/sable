+#[cfg(all(test, feature = "dim3"))]
+mod planetary_contact_guard_tests {
+    use super::*;
+    use crate::geometry::{ColliderBuilder, SharedShape};
+    use crate::math::Pose;
+
+    fn limits(pairs:usize) -> PlanetaryContactLimits {
+        PlanetaryContactLimits { pairs, manifolds:pairs*2, points:pairs*96 }
+    }
+    fn boxes() -> (ColliderSet, ColliderHandle, ColliderHandle) {
+        let mut colliders=ColliderSet::new();
+        let a=colliders.insert(ColliderBuilder::cuboid(1.,1.,1.).build());
+        let b=colliders.insert(ColliderBuilder::cuboid(1.,1.,1.).build());
+        (colliders,a,b)
+    }
+    #[test]
+    fn planetary_guard_refuses_before_pair_allocation() {
+        let (colliders,a,b)=boxes();let mut phase=NarrowPhase::new();
+        let guard=PlanetaryContactGuard::new(limits(0));
+        phase.planetary_guard_contacts(&colliders,&guard).unwrap();
+        phase.add_pair(&colliders,&ColliderPair { collider1:a,collider2:b });
+        assert_eq!(phase.contact_pairs().count(),0);
+        assert!(phase.contact_graph.graph.nodes.is_empty());
+        assert!(guard.snapshot().is_err());
+    }
+    #[test]
+    fn planetary_guard_charges_compound_old_and_new_manifolds() {
+        let (mut colliders,a,_)=boxes();
+        let shape=SharedShape::compound((0..4).map(|_|(Pose::IDENTITY,SharedShape::cuboid(1.,1.,1.))).collect());
+        let b=colliders.insert(ColliderBuilder::new(shape).build());
+        let mut phase=NarrowPhase::new();
+        let guard=PlanetaryContactGuard::new(PlanetaryContactLimits {pairs:1,manifolds:7,points:384});
+        phase.planetary_guard_contacts(&colliders,&guard).unwrap();
+        phase.add_pair(&colliders,&ColliderPair {collider1:a,collider2:b});
+        assert_eq!(phase.contact_pairs().count(),0);
+        assert!(guard.snapshot().is_err());
+        let exact=PlanetaryContactGuard::new(PlanetaryContactLimits {pairs:1,manifolds:8,points:384});
+        let mut phase=NarrowPhase::new();phase.planetary_guard_contacts(&colliders,&exact).unwrap();
+        phase.add_pair(&colliders,&ColliderPair {collider1:a,collider2:b});
+        assert_eq!(phase.contact_pairs().count(),1);
+        assert_eq!(exact.snapshot().unwrap().reserved.manifolds,8);
+    }
+    #[test]
+    fn planetary_guard_rejects_unsupported_shapes_and_sensors() {
+        for sensor in [false,true] {
+            let (mut colliders,a,_)=boxes();
+            let b=colliders.insert(if sensor {ColliderBuilder::cuboid(1.,1.,1.).sensor(true).build()}
+                else {ColliderBuilder::ball(1.).build()});
+            let mut phase=NarrowPhase::new();let guard=PlanetaryContactGuard::new(limits(8));
+            phase.planetary_guard_contacts(&colliders,&guard).unwrap();
+            phase.add_pair(&colliders,&ColliderPair {collider1:a,collider2:b});
+            assert_eq!(phase.contact_pairs().count(),0);
+            assert!(phase.intersection_graph.graph.edges.is_empty());
+            assert!(guard.snapshot().is_err());
+        }
+    }
+    #[test]
+    fn planetary_guard_parallel_reservations_cannot_oversubscribe() {
+        let guard=PlanetaryContactGuard::new(limits(8));
+        let accepted=std::sync::atomic::AtomicUsize::new(0);
+        std::thread::scope(|scope| {
+            for i in 0..32 {
+                let guard=&guard;let accepted=&accepted;
+                scope.spawn(move || {
+                    let co=ColliderBuilder::cuboid(1.,1.,1.).build();
+                    if guard.reserve(ColliderHandle::from_raw_parts(i*2,0),ColliderHandle::from_raw_parts(i*2+1,0),&co,&co) {
+                        accepted.fetch_add(1,std::sync::atomic::Ordering::SeqCst);
+                    }
+                });
+            }
+        });
+        assert_eq!(accepted.load(std::sync::atomic::Ordering::SeqCst),8);
+        assert_eq!(guard.reserved(),limits(8));assert!(guard.snapshot().is_err());
+    }
+    #[test]
+    fn planetary_guard_release_requires_actual_pair_removal() {
+        let (colliders,a,b)=boxes();let mut phase=NarrowPhase::new();
+        phase.add_pair(&colliders,&ColliderPair {collider1:a,collider2:b});
+        let guard=PlanetaryContactGuard::new(limits(1));phase.planetary_guard_contacts(&colliders,&guard).unwrap();
+        // Merely clearing manifolds does not remove the allocated pair/workspace reservation.
+        phase.contact_graph.graph.edges[0].weight.clear();guard.observe(phase.contact_pairs());
+        assert_eq!(guard.snapshot().unwrap().reserved,limits(1));
+        let ga=phase.graph_indices.get(a.0).unwrap().contact_graph_index;
+        let gb=phase.graph_indices.get(b.0).unwrap().contact_graph_index;
+        drop(phase.contact_graph.remove_edge(ga,gb));guard.observe(phase.contact_pairs());
+        assert_eq!(guard.snapshot().unwrap().reserved,limits(0));
+        assert_eq!(guard.snapshot().unwrap().actual,limits(0));
+    }
