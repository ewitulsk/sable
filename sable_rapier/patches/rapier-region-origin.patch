 impl IslandManager {
+    /// Import source island membership in source order, retaining sleep components and candidates.
+    /// The caller has already proved that active contacts/joints cannot cross the selected group.
+    pub fn planetary_import_islands(&mut self, source: &Self, bodies: &mut RigidBodySet, remap: &[(RigidBodyHandle, RigidBodyHandle)]) {
+        let mapped = |old: RigidBodyHandle| remap.iter().find(|(a, _)| *a == old).map(|(_, b)| *b);
+        for (_, original) in source.islands.iter() {
+            let handles: Vec<_> = original.bodies.iter().filter_map(|h| mapped(*h)).collect();
+            if handles.is_empty() { continue; }
+            let mut imported = original.clone();
+            imported.bodies = handles;
+            let id = self.free_islands.pop().unwrap_or(self.islands.len());
+            imported.id_in_awake_list = if original.is_sleeping() { None } else {
+                let awake = self.awake_islands.len(); self.awake_islands.push(id); Some(awake)
+            };
+            for (index, handle) in imported.bodies.iter().enumerate() {
+                let rb = bodies.index_mut_internal(*handle);
+                rb.ids.active_island_id = id;
+                rb.ids.active_set_id = index;
+                // Timestamp is a destination traversal marker, not transferable physical state.
+                rb.ids.active_set_timestamp = self.traversal_timestamp.wrapping_sub(1);
+            }
+            self.islands.insert(id, imported);
+        }
+        for candidate in &source.traversal_candidates {
+            if let Some(handle) = mapped(candidate.0) { self.traversal_candidates.push_back(SleepCandidate(handle)); }
+        }
+    }
+
