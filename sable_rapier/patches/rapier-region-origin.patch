+mod planetary_sweep_tests {
+// Regression coverage for the staged planetary collector. These tests exercise the actual
+// pipeline and CCD queries; the final capacity case isolates the explicit bounded accumulator.
+use crate::prelude::*;
+
+struct World {
+    pipeline: PhysicsPipeline,
+    bodies: RigidBodySet,
+    colliders: ColliderSet,
+    islands: IslandManager,
+    broad: BroadPhaseBvh,
+    narrow: NarrowPhase,
+    joints: ImpulseJointSet,
+    multibodies: MultibodyJointSet,
+    ccd: CCDSolver,
+}
+impl World {
+    fn new() -> Self {
+        Self { pipeline: PhysicsPipeline::new(), bodies: RigidBodySet::new(),
+            colliders: ColliderSet::new(), islands: IslandManager::new(), broad: BroadPhaseBvh::new(),
+            narrow: NarrowPhase::new(), joints: ImpulseJointSet::new(),
+            multibodies: MultibodyJointSet::new(), ccd: CCDSolver::new() }
+    }
+    fn body(&mut self, velocity: Vector) -> (RigidBodyHandle, ColliderHandle) {
+        let body = self.bodies.insert(RigidBodyBuilder::dynamic().linvel(velocity)
+            .ccd_enabled(true).soft_ccd_prediction(2.0).linear_damping(0.0).angular_damping(0.0));
+        let collider = self.colliders.insert_with_parent(ColliderBuilder::cuboid(0.125,0.125,0.125)
+            .mass(1.0).friction(0.0).restitution(0.0),body,&mut self.bodies);
+        self.bodies[body].recompute_mass_properties_from_colliders(&self.colliders);
+        (body,collider)
+    }
+    fn staged_clone(&self) -> Self {
+        assert!(self.bodies.iter().all(|(_,body)|body.planetary_sweep.is_none()));
+        Self { pipeline: PhysicsPipeline::new(), bodies: self.bodies.clone(), colliders: self.colliders.clone(),
+            islands: self.islands.clone(), broad: self.broad.clone(), narrow: self.narrow.clone(),
+            joints: self.joints.clone(), multibodies: self.multibodies.clone(), ccd: CCDSolver::new() }
+    }
+    fn step(&mut self, dt: Real) {
+        let parameters = IntegrationParameters {dt,max_ccd_substeps:4,..IntegrationParameters::default()};
+        self.pipeline.step(Vector::ZERO,&parameters,&mut self.islands,&mut self.broad,&mut self.narrow,
+            &mut self.bodies,&mut self.colliders,&mut self.joints,&mut self.multibodies,&mut self.ccd,&(),&());
+    }
+}
+fn same_bounds(a:&PlanetarySweepBounds,b:&PlanetarySweepBounds) {
+    assert_eq!(a.mins,b.mins);assert_eq!(a.maxs,b.maxs);assert_eq!(a.samples,b.samples);
+    assert_eq!(a.solver_segments,b.solver_segments);assert_eq!(a.ccd_predictions,b.ccd_predictions);
+    assert_eq!(a.ccd_clamps,b.ccd_clamps);assert_eq!(a.broad_phase_queries,b.broad_phase_queries);
+}
