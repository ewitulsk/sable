diff --git a/src/geometry/broad_phase_bvh.rs b/src/geometry/broad_phase_bvh.rs
--- a/src/geometry/broad_phase_bvh.rs
+++ b/src/geometry/broad_phase_bvh.rs
@@ -53,6 +53,20 @@ pub enum BvhOptimizationStrategy {
 const ENABLE_TREE_VALIDITY_CHECK: bool = false;
 
 impl BroadPhaseBvh {
+    /// Rebuild the bounded scene's tree using translated existing leaf bounds, preserving pairs.
+    /// Leaf padding/prediction and collider generations are retained; pending adds/removals stay pending.
+    pub fn planetary_shift_origin(&mut self, delta: crate::math::Vector, colliders: &ColliderSet) {
+        let leaves: Vec<_> = colliders.iter().filter_map(|(handle, _)| {
+            let key = handle.into_raw_parts().0;
+            self.tree.leaf_node(key).map(|leaf| {
+                let aabb = leaf.aabb();
+                (key as usize, Aabb::new(aabb.mins - delta, aabb.maxs - delta))
+            })
+        }).collect();
+        self.tree = Bvh::from_iter(parry::partitioning::BvhBuildStrategy::Binned, leaves);
+        self.workspace = BvhWorkspace::default();
+    }
+
     const CHANGE_DETECTION_ENABLED: bool = true;
     const CHANGE_DETECTION_FACTOR: Real = 1.0e-2;
 
