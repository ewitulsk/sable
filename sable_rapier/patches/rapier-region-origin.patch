+/// Bounded diagnostic envelope owned by one staged planetary body. This collector does not
+/// change integration or authorize publication; the scene preview owner checks residency.
+#[derive(Clone, Debug)]
+pub struct PlanetarySweepTrace {
+    inner: std::sync::Arc<std::sync::Mutex<PlanetarySweepBounds>>,
+    radius: Real,
+    local_com: Vector,
+}
+#[derive(Clone, Debug)]
+pub struct PlanetarySweepBounds {
+    pub mins: Vector,
+    pub maxs: Vector,
+    pub samples: u32,
+    pub solver_segments: u32,
+    pub ccd_predictions: u32,
+    pub ccd_clamps: u32,
+    pub broad_phase_queries: u32,
+    invalid: bool,
+}
+impl PlanetarySweepTrace {
+    fn record_bounds(&self, mins: Vector, maxs: Vector, kind: u8) {
+        // A poisoned trace remains unreadable: never turn missing observations into coverage.
+        if let Ok(mut trace) = self.inner.lock() {
+            if trace.invalid { return; }
+            if !mins.is_finite() || !maxs.is_finite() || !mins.cmple(maxs).all() || trace.samples == 65536 {
+                trace.invalid = true;
+                return;
+            }
+            trace.mins = trace.mins.min(mins);
+            trace.maxs = trace.maxs.max(maxs);
+            trace.samples += 1;
+            match kind {
+                1 => trace.solver_segments += 1,
+                2 => trace.ccd_predictions += 1,
+                3 => trace.ccd_clamps += 1,
+                4 => trace.broad_phase_queries += 1,
+                _ => {}
+            }
+        }
+    }
+    pub(crate) fn record_solver_segment(&self, start: Vector, end: Vector) {
+        let halo = Vector::splat(self.radius);
+        self.record_bounds(start.min(end) - halo, start.max(end) + halo, 1);
+    }
+    fn record_pose(&self, pose: &Pose, kind: u8) {
+        let center = pose.translation + pose.rotation * self.local_com;
+        let halo = Vector::splat(self.radius);
+        self.record_bounds(center - halo, center + halo, kind);
+    }
+    pub fn snapshot(&self) -> Result<PlanetarySweepBounds, &'static str> {
+        let trace = self.inner.lock().map_err(|_| "planetary sweep collector poisoned")?;
+        if trace.invalid || trace.samples == 0 { return Err("planetary sweep collector incomplete or exhausted"); }
+        Ok(trace.clone())
+    }
+}
