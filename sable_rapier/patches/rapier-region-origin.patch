 impl BroadPhaseBvh {
+    /// Build broad-phase leaves for an actor-free scene without advancing its simulation clock.
+    pub fn planetary_initialize_static(&mut self, params: &IntegrationParameters, bodies: &RigidBodySet, colliders: &ColliderSet) {
+        for (handle, collider) in colliders.iter() {
+            if collider.is_enabled() { self.set_aabb(params, handle, collider.compute_broad_phase_aabb(params, bodies)); }
+        }
+    }
+
+    /// Preserve a transferred collider's padded/predicted leaf without flagging a user edit.
+    pub fn planetary_import_leaf(&mut self, source: &Self, old: ColliderHandle, new: ColliderHandle, delta: crate::math::Vector) {
+        if let Some(leaf) = source.tree.leaf_node(old.into_raw_parts().0) {
+            let aabb = leaf.aabb();
+            self.tree.insert_with_change_detection(Aabb::new(aabb.mins - delta, aabb.maxs - delta), new.into_raw_parts().0, 0.0);
+        }
+    }
+
+    /// Rebuild the bounded scene's tree using translated existing leaf bounds, preserving pairs.
+    /// Leaf padding/prediction and collider generations are retained; pending adds/removals stay pending.
+    pub fn planetary_shift_origin(&mut self, delta: crate::math::Vector, colliders: &ColliderSet) {
+        let leaves: Vec<_> = colliders.iter().filter_map(|(handle, _)| {
+            let key = handle.into_raw_parts().0;
+            self.tree.leaf_node(key).map(|leaf| {
+                let aabb = leaf.aabb();
+                (key as usize, Aabb::new(aabb.mins - delta, aabb.maxs - delta))
+            })
+        }).collect();
+        self.tree = Bvh::from_iter(parry::partitioning::BvhBuildStrategy::Binned, leaves);
+        self.workspace = BvhWorkspace::default();
+    }
+
