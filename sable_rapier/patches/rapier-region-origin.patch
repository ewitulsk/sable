 impl RigidBodySet {
+    /// Finalize an actor-free terrain scene without waking or integrating any body.
+    pub fn planetary_clear_static_changes(&mut self) {
+        assert!(self.bodies.iter().all(|(_, body)| body.is_fixed()));
+        for (_, body) in self.bodies.iter_mut() { body.changes = RigidBodyChanges::empty(); }
+        self.modified_bodies.clear();
+    }
+
+    /// Preserve every physical field while keeping newly allocated destination links.
+    pub fn planetary_restore_imported_body(&mut self, handle: RigidBodyHandle, original: &RigidBody, delta: crate::math::Vector) {
+        let imported = self.bodies.get_mut(handle.0).unwrap();
+        let ids = imported.ids;
+        let colliders = imported.colliders.clone();
+        *imported = original.clone();
+        imported.ids = ids;
+        imported.colliders = colliders;
+        imported.pos.position.translation -= delta;
+        imported.pos.next_position.translation -= delta;
+        imported.mprops.world_com -= delta;
+        imported.changes = original.changes | RigidBodyChanges::IN_MODIFIED_SET;
+    }
+    /// Translate a complete scene's coordinate origin without waking bodies or changing motion.
+    /// The caller must also shift its colliders, narrow phase, and broad phase atomically.
+    pub fn planetary_shift_origin(&mut self, delta: crate::math::Vector) {
+        for (_, body) in self.bodies.iter_mut() {
+            body.pos.position.translation -= delta;
+            body.pos.next_position.translation -= delta;
+            body.mprops.world_com -= delta;
+        }
+    }
+
