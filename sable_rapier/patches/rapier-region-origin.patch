+#[test]
+fn planetary_sweep_fast_opposing_force_includes_real_ccd_query() {
+    let mut source=World::new();
+    let (body,_)=source.body(Vector::new(320.0,0.0,0.0));
+    // Establish the real previous CCD velocity via one actual step, not a fabricated
+    // internal activation flag; a newly allocated body's ccd_vels starts at zero.
+    source.step(0.001);
+    source.bodies[body].add_force(Vector::new(-6400.0,0.0,0.0),true);
+    let source_pose=*source.bodies[body].position();let source_velocity=source.bodies[body].linvel();
+    let mut candidate=source.staged_clone();let mut control=source.staged_clone();
+    let radius=Vector::splat(0.125).length();
+    let trace=candidate.bodies[body].planetary_begin_sweep(radius);
+    candidate.step(0.05);control.step(0.05);
+    let bounds=trace.snapshot().expect("actual pipeline collector must be readable");
+    // The first actual CCD pass predicts the initial fast velocity before this step's
+    // user force is assembled. Later solver integration decelerates. Final-only bounds
+    // would miss that real 16 m cast/query, even with no other dynamic body in the scene.
+    assert!(bounds.ccd_predictions>0,"no real CCD prediction was observed");
+    assert!(bounds.broad_phase_queries>0,"no real cached/query AABB was observed");
+    assert!(bounds.solver_segments>0,"no actual integration segment was observed");
+    assert!(bounds.maxs.x>=source_pose.translation.x+16.0+radius-1.0e-10,"initial fast CCD cast was omitted: {bounds:?}");
+    assert!(bounds.maxs.x>candidate.bodies[body].position().translation.x+radius+0.01,
+        "fixture did not separate internal CCD traversal from final pose");
+    // Recording must not alter the exact physical solve or mutate authoritative source.
+    assert_eq!(candidate.bodies[body].position(),control.bodies[body].position());
+    assert_eq!(candidate.bodies[body].linvel(),control.bodies[body].linvel());
+    assert_eq!(*source.bodies[body].position(),source_pose);assert_eq!(source.bodies[body].linvel(),source_velocity);
+    assert!(source.bodies[body].planetary_sweep.is_none());
+    candidate.bodies[body].planetary_end_sweep().unwrap();
+    candidate.pipeline=PhysicsPipeline::new();
+}
+
+#[test]
+fn planetary_sweep_deferred_offcenter_mass_change_refuses_stale_radius() {
+    let mut world=World::new();let (body,collider)=world.body(Vector::new(1.0,0.0,0.0));
+    assert_eq!(world.bodies[body].mprops.local_mprops.local_com,Vector::ZERO);
+    let trace=world.bodies[body].planetary_begin_sweep(0.25);
+    // This queues the real collider-parent and mass update; do not call the validator
+    // directly, because the regression is the pipeline's deferred user-change ordering.
+    world.colliders[collider].set_translation_wrt_parent(Vector::new(3.0,0.0,0.0));
+    world.step(0.01);
+    assert_eq!(world.bodies[body].mprops.local_mprops.local_com,Vector::new(3.0,0.0,0.0));
+    assert!(trace.snapshot().is_err(),"stale COM/radius was silently accepted");
+    world.bodies[body].planetary_end_sweep().unwrap();
+}
+
+#[test]
+fn planetary_sweep_solver_buffer_reuse_does_not_append_to_retired_trace() {
+    let mut world=World::new();let (body,_)=world.body(Vector::new(20.0,0.0,0.0));
+    let first=world.bodies[body].planetary_begin_sweep(0.25);world.step(0.025);
+    world.bodies[body].planetary_end_sweep().unwrap();let completed=first.snapshot().unwrap();
+    // Deliberately reuse the same real scratch pipeline here to exercise its clear/resize
+    // path. Production additionally replaces this scratch pipeline before publication.
+    let second=world.bodies[body].planetary_begin_sweep(0.25);world.step(0.025);
+    assert!(second.snapshot().unwrap().solver_segments>0);
+    same_bounds(&completed,&first.snapshot().unwrap());
+    world.bodies[body].planetary_end_sweep().unwrap();world.step(0.025);
+    same_bounds(&completed,&first.snapshot().unwrap());
+}
+
+#[test]
+fn planetary_sweep_capacity_exhaustion_invalidates_all_trace_handles() {
+    let mut body=RigidBodyBuilder::dynamic().build();let trace=body.planetary_begin_sweep(1.0);
+    let retained=trace.clone();
+    // begin_sweep recorded exactly the current and next pose. No allocation or silent
+    // truncation is permitted when another actual observation exceeds the fixed cap.
+    for _ in 2..65536 {trace.record_solver_segment(Vector::ZERO,Vector::X);}
+    assert_eq!(trace.snapshot().unwrap().samples,65536);
+    trace.record_solver_segment(Vector::ZERO,Vector::X);
+    assert!(trace.snapshot().is_err());assert!(retained.snapshot().is_err());
+}
