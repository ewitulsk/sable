 impl ColliderSet {
+    /// Used only after rebuilding the complete actor-free scene's spatial indexes.
+    pub fn planetary_clear_static_changes(&mut self) {
+        for (_, collider) in self.colliders.iter_mut() { collider.changes = ColliderChanges::empty(); }
+        self.modified_colliders.clear();
+        self.removed_colliders.clear();
+    }
+
+    /// Insert a cloned collider without falsely invalidating its cached shape workspace.
+    pub fn planetary_import_collider(&mut self, original: &Collider, parent: RigidBodyHandle, bodies: &mut RigidBodySet, delta: crate::math::Vector) -> ColliderHandle {
+        let mut collider = original.clone();
+        collider.parent.as_mut().expect("imported collider requires parent").handle = parent;
+        collider.pos.0.translation -= delta;
+        let handle = ColliderHandle(self.colliders.insert(collider));
+        bodies.index_mut_internal(parent).colliders.0.push(handle);
+        // A translated import is not a user position edit. Preserve genuine pending edits only.
+        // Broad-phase insertion is performed separately by the transfer transaction.
+        if original.changes.contains(ColliderChanges::IN_MODIFIED_SET) {
+            self.modified_colliders.push_unchecked(handle, &mut self.colliders[handle.0]);
+        }
+        handle
+    }
